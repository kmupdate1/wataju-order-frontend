{
  "openapi": "3.0.3",
  "info": {
    "title": "Wataju customer order API",
    "version": "0.2.0"
  },
  "servers": [
    {
      "url": "/api/customer"
    }
  ],
  "paths": {
    "/me": {
      "get": {
        "summary": "Read the active customer profile",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Account"
                }
              }
            }
          },
          "401": {
            "description": "Sign in required"
          },
          "403": {
            "description": "Access denied"
          }
        }
      }
    },
    "/me/destination": {
      "put": {
        "summary": "Update the default delivery destination",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Account"
                }
              }
            }
          },
          "401": {
            "description": "Sign in required"
          },
          "403": {
            "description": "Access denied"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Destination"
              }
            }
          }
        }
      }
    },
    "/quotes": {
      "post": {
        "summary": "Validate SKU, quantity and customer terms; snapshot prices, tax and shipping",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Quote"
                }
              }
            }
          },
          "401": {
            "description": "Sign in required"
          },
          "403": {
            "description": "Access denied"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QuoteRequest"
              }
            }
          }
        }
      }
    },
    "/orders": {
      "get": {
        "summary": "List snapshots for the current customer",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Order"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Sign in required"
          },
          "403": {
            "description": "Access denied"
          }
        }
      },
      "post": {
        "summary": "Confirm the quote owned by the authenticated customer; replay the original receipt for the same key.",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                }
              }
            }
          },
          "401": {
            "description": "Sign in required"
          },
          "403": {
            "description": "Access denied"
          },
          "410": {
            "description": "Quote expired without acceptance. Request a new quote."
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Confirmation"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "Destination": {
        "type": "object",
        "required": [
          "recipient",
          "postal",
          "address"
        ],
        "properties": {
          "recipient": {
            "type": "string"
          },
          "postal": {
            "type": "string"
          },
          "address": {
            "type": "string"
          }
        }
      },
      "BasketItem": {
        "type": "object",
        "required": [
          "sku",
          "quantity"
        ],
        "properties": {
          "sku": {
            "type": "string"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 99
          }
        }
      },
      "OrderLine": {
        "type": "object",
        "required": [
          "sku",
          "name",
          "size",
          "quantity",
          "unitPrice"
        ],
        "properties": {
          "sku": {
            "type": "string"
          },
          "name": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "size": {
            "type": "string"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1
          },
          "unitPrice": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        }
      },
      "Account": {
        "type": "object",
        "required": [
          "displayName",
          "destination"
        ],
        "properties": {
          "displayName": {
            "type": "string"
          },
          "destination": {
            "$ref": "#/components/schemas/Destination"
          }
        }
      },
      "QuoteRequest": {
        "type": "object",
        "required": [
          "items",
          "destination"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BasketItem"
            }
          },
          "destination": {
            "$ref": "#/components/schemas/Destination"
          }
        }
      },
      "Quote": {
        "type": "object",
        "required": [
          "id",
          "currency",
          "lines",
          "shipping",
          "tax",
          "total"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "currency": {
            "type": "string"
          },
          "lines": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrderLine"
            }
          },
          "shipping": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "tax": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "total": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        }
      },
      "Order": {
        "type": "object",
        "required": [
          "id",
          "quote"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "quote": {
            "$ref": "#/components/schemas/Quote"
          }
        }
      },
      "Confirmation": {
        "type": "object",
        "required": [
          "quoteId"
        ],
        "properties": {
          "quoteId": {
            "type": "string"
          }
        }
      }
    }
  }
}
